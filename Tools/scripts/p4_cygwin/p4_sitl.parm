# p4_sitl.parm -- the parameter set of the P4 SITL flights at W_DJ = 1 (2026-11-13)
# Generated by make_sitl_parm.py from the harness sources; do not edit by hand.
# Firmware: ardupilot fork branch p4-wdj1 (06c2b43959), BSLV_ARC=1 build (revision v2e +
# BSLV_WDJ). Vehicle model: SITL frame model SN77.json, launched as --model +:SN77.json.
# Every value below was cross-checked against the PARM records of the flown SITL log
# (make_sitl_parm.py --check).  Later lines override earlier ones (as on the vehicle).
# NOTE: the harness does NOT load scripts/sitl_validation/SN77.parm (its MOT_/ATC_/WP_ tune
# and the 5.4 m/s wind); the flights fly the stock SITL tune of block 1 in still air.
# NOTE: the BSLV_* values are read at engage (switch to AUTO); no reboot is needed for them.
# Not included (the harness sends them, this firmware has no such parameter):
#   ANGLE_MAX 3000: not a parameter in this firmware (ATC_ANGLE_MAX = 30 deg is the default)
#   ARMING_CHECK 0: not a parameter in this firmware (ARMING_SKIPCHK, default 0 = all checks on)
# and from copter.parm: ARSPD_BUS, ARSPD_PIN (airspeed is not in ArduCopter).
# Comments sit on their own lines (Mission Planner reads NAME,VALUE per line).
#
# ---- 1. ardupilot/Tools/autotest/default_params/copter.parm (SITL copter defaults, as sim_vehicle.py passes them)
FRAME_TYPE,0
FS_THR_ENABLE,1
ATC_RAT_YAW_P,0.3
ATC_RAT_YAW_I,0.02
BATT_MONITOR,4
COMPASS_OFS_X,5
COMPASS_OFS_Y,13
COMPASS_OFS_Z,-18
COMPASS_OFS2_X,5
COMPASS_OFS2_Y,13
COMPASS_OFS2_Z,-18
COMPASS_OFS3_X,5
COMPASS_OFS3_Y,13
COMPASS_OFS3_Z,-18
FENCE_RADIUS,150
FRAME_CLASS,1
RC1_MAX,2000.000000
RC1_MIN,1000.000000
RC1_TRIM,1500.000000
RC2_MAX,2000.000000
RC2_MIN,1000.000000
RC2_TRIM,1500.000000
RC3_MAX,2000.000000
RC3_MIN,1000.000000
RC3_TRIM,1500.000000
RC4_MAX,2000.000000
RC4_MIN,1000.000000
RC4_TRIM,1500.000000
RC5_MAX,2000.000000
RC5_MIN,1000.000000
RC5_TRIM,1500.000000
RC6_MAX,2000.000000
RC6_MIN,1000.000000
RC6_TRIM,1500.000000
RC7_MAX,2000.000000
RC7_MIN,1000.000000
RC7_OPTION,7
RC7_TRIM,1500.000000
RC8_MAX,2000.000000
RC8_MIN,1000.000000
RC8_TRIM,1500.000000
FLTMODE1,7
FLTMODE2,9
FLTMODE3,6
FLTMODE4,3
FLTMODE5,5
FLTMODE6,0
SIM_BARO_RND,0
INS_ACCOFFS_X,0.001
INS_ACCOFFS_Y,0.001
INS_ACCOFFS_Z,0.001
INS_ACCSCAL_X,1.001
INS_ACCSCAL_Y,1.001
INS_ACCSCAL_Z,1.001
INS_ACC2OFFS_X,0.001
INS_ACC2OFFS_Y,0.001
INS_ACC2OFFS_Z,0.001
INS_ACC2SCAL_X,1.001
INS_ACC2SCAL_Y,1.001
INS_ACC2SCAL_Z,1.001
INS_ACC3OFFS_X,0.000
INS_ACC3OFFS_Y,0.000
INS_ACC3OFFS_Z,0.000
INS_ACC3SCAL_X,1.000
INS_ACC3SCAL_Y,1.000
INS_ACC3SCAL_Z,1.000
MOT_THST_EXPO,0.65
MOT_THST_HOVER,0.39
MOT_BAT_VOLT_MIN,9.6
MOT_BAT_VOLT_MAX,12.8
#
# ---- 2. scripts/sitl_validation/bslv_sitl.parm (no floating-point-exception trap, as on the flight controller)
SIM_FLOAT_EXCEPT,0
#
# ---- 3. defaults the SITL frame model SN77.json sets (SIM_Frame.cpp); identical when the same model file is loaded
SIM_BATT_VOLTAGE,25.2
SIM_BATT_CAP_AH,10
BATT_CAPACITY,10000
#
# ---- 4. run-time sets of fly_bsolver_auto.py for the v2e_wdj1 flights at (q,K) = (1,3)
# BSLV_ENABLE: enable the onboard planner (AP_BSolver)
BSLV_ENABLE,1
# WP_SPD: SN77 drag-limited cruise; the runtime mission builder derives its pace from it (m/s, SI name in this tree)
WP_SPD,11.8
# BSLV_Q: budget q = 1 (the real-flight budget; the firmware default 2 does not fit the H743 period)
BSLV_Q,1
# BSLV_K: K = 3 rounds per tick
BSLV_K,3
# BSLV_SEED: jerk-limited ramp engage seed (firmware default)
BSLV_SEED,1
# BSLV_WDJ: world-frame jerk-change penalty W_DJ = 1 (firmware default 1.0)
BSLV_WDJ,1
# BSLV_QE: as the harness sets it (equals the firmware default)
BSLV_QE,60
# PSC_ANGLE_MAX: position-controller lean limit 35 deg (real SN77 value)
PSC_ANGLE_MAX,35
# LOG_DISARMED: the harness logs while disarmed too (it sets this before arming)
LOG_DISARMED,1
